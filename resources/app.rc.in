#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/resources/resource.h"

IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"
IDR_ASSASSIN_NONE RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-none.png"
IDR_ASSASSIN_2 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-2.png"
IDR_ASSASSIN_3 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-3.png"
IDR_ASSASSIN_CLOCK RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-clock.png"

IDR_ASSASSIN_2_40 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-2-40.png"
IDR_ASSASSIN_3_40 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-3-40.png"
IDR_ASSASSIN_CLOCK_40 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/assassin-clock-40.png"

LANGUAGE LANG_PORTUGUESE, SUBLANG_PORTUGUESE_BRAZILIAN
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "FileDescription", "Albion Assistant\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "AlbionAssistant\0"
            VALUE "OriginalFilename", "AlbionAssistant.exe\0"
            VALUE "ProductName", "Albion Assistant\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
